TEXT 48 56 Left 3 ;supply, bulk bank, load
TEXT 48 376 Left 3 ;cell 1
TEXT 48 776 Left 3 ;cell 2
TEXT 48 1176 Left 3 ;low-side driver (pulsed): Kelvin star from both QL sources
TEXT 48 1672 Left 3 ;high-side driver (held off at 0 V through the pull-down)
TEXT 2240 64 Left 2 ;Double-pulse test, low-side DUT: 2 x EPC2361 per switch, power loop = Q3D PL_A copper matrix
TEXT 2240 96 Left 2 ;
TEXT 2240 128 Left 2 ;Open in LTspice and Run (Alternate solver), or batch:  run_dpt.cmd
TEXT 2240 160 Left 2 ;Cells:  cell k (k = 1, 2) = PL_A copper subcircuit + QHk + QLk + local MLCC bank.
TEXT 2240 192 Left 2 ;Low-side DPT: load inductor between switch node SW and DC+ (BUSP); QH held off; QL1/QL2 pulsed.
TEXT 2240 224 Left 2 ;Plot e.g.  V(qld1,qls1)  I(Vidl1)  I(Vidl2)  V(gl1,qls1)  V(gh1,qhs1)  I(Lload)
TEXT 2240 256 Left 2 ;
TEXT 2240 288 Left 2 ;Assumptions (edit the .param lines):
TEXT 2240 320 Left 2 ;- PL_A matrix is the 100 MHz copper-only partial R/L of one cell (simulation/q3d/results/PL_A.lib)
TEXT 2240 352 Left 2 ;- no mutual coupling between the two cells; DC/AC distribution between cells lumped (LDIST, LAC)
TEXT 2240 384 Left 2 ;- MLCC bank: 6 x 1 uF 0805 per cell, CMLCC = effective capacitance at 75 V (assumed 50 %)
TEXT 2240 416 Left 2 ;- driver: LT8418-like split output, 0.6 ohm pull-up / 0.2 ohm pull-down, 5 V, 1 ns source edges
TEXT 2240 448 Left 2 ;- gate loop per FET from Q3D: 2.0 nH (8 mm) near / 7.7 nH (25 mm) far; star routing ~2.1 nH each
TEXT 2240 480 Left 2 ;gate routing: GATEMODE 0 = star (equal branches), 1 = direct from a left driver (near/far)
TEXT 2240 512 Left 2 ;switched current and sharing at the end of the first pulse (QL turn-off)
TEXT 2240 544 Left 2 ;QL turn-off: VDS overshoot and turn-off energy (both FETs), 300 ns window
TEXT 2240 576 Left 2 ;QL turn-on (second pulse): QH VDS overshoot, QL peak currents and energy, false turn-on of QH
TEXT 2240 608 Left 2 ;switching speed: low-side VDS fall at turn-on (90 % -> 10 % of the bus)
TEXT 2240 672 Left 2 !.param VBUS=75 IPK=120 LLOAD=20u
TEXT 2240 704 Left 2 !.param TSTART=1u TON1={LLOAD*IPK/VBUS} TOFF=2u TON2=1u TTAIL=1u
TEXT 2240 736 Left 2 !.param T1={TSTART+TON1} T2={T1+TOFF} T3={T2+TON2} TEND={T3+TTAIL}
TEXT 2240 768 Left 2 !.param VDRV=5 RPU=0.6 RPD=0.2 RGON=2 RGOFF=0.01 LTRUNK=0.5n RKS=0.1
TEXT 2240 800 Left 2 !.param CMLCC=3u RMLCC=1m LMLCC=0.08n
TEXT 2240 832 Left 2 !.param LDIST=1n LAC=0.5n CBULK=1.54m RBULK=15m LBULK=3n
TEXT 2240 864 Left 2 !.param LG1={if(GATEMODE,2.0n,2.1n)} LG2={if(GATEMODE,7.7n,2.1n)}
TEXT 2240 896 Left 2 !.step param GATEMODE list 0 1
TEXT 2240 928 Left 2 !.include ../q3d/results/PL_A.lib
TEXT 2240 960 Left 2 !.include ../LMG1210-EPC2361/EPC2361.lib
TEXT 2240 992 Left 2 !.model DIDEAL D(Ron=1m Roff=1G Vfwd=0)
TEXT 2240 1024 Left 2 !.options plotwinsize=0 method=gear
TEXT 2240 1056 Left 2 !.tran 0 {TEND} 0 0.2n
TEXT 2240 1088 Left 2 !.meas TRAN IL_off FIND I(Lload) AT {T1}
TEXT 2240 1120 Left 2 !.meas TRAN ID1_off FIND I(VIDL1) AT {T1}
TEXT 2240 1152 Left 2 !.meas TRAN ID2_off FIND I(VIDL2) AT {T1}
TEXT 2240 1184 Left 2 !.meas TRAN VDSL_pk MAX V(QLD1,QLS1) FROM {T1} TO {T1+300n}
TEXT 2240 1216 Left 2 !.meas TRAN VDSL2_pk MAX V(QLD2,QLS2) FROM {T1} TO {T1+300n}
TEXT 2240 1248 Left 2 !.meas TRAN Eoff1 INTEG V(QLD1,QLS1)*I(VIDL1) FROM {T1} TO {T1+300n}
TEXT 2240 1280 Left 2 !.meas TRAN Eoff2 INTEG V(QLD2,QLS2)*I(VIDL2) FROM {T1} TO {T1+300n}
TEXT 2240 1312 Left 2 !.meas TRAN VDSH_pk MAX V(QHD1,QHS1) FROM {T2} TO {T2+300n}
TEXT 2240 1344 Left 2 !.meas TRAN ID1_pk MAX I(VIDL1) FROM {T2} TO {T2+300n}
TEXT 2240 1376 Left 2 !.meas TRAN ID2_pk MAX I(VIDL2) FROM {T2} TO {T2+300n}
TEXT 2240 1408 Left 2 !.meas TRAN Eon1 INTEG V(QLD1,QLS1)*I(VIDL1) FROM {T2} TO {T2+300n}
TEXT 2240 1440 Left 2 !.meas TRAN Eon2 INTEG V(QLD2,QLS2)*I(VIDL2) FROM {T2} TO {T2+300n}
TEXT 2240 1472 Left 2 !.meas TRAN VGSH_pk MAX V(gh1x,QHS1) FROM {T2} TO {T2+300n}
TEXT 2240 1504 Left 2 !.meas TRAN VGSL_min MIN V(gl1x,QLS1) FROM {T1} TO {T1+300n}
TEXT 2240 1536 Left 2 !.meas TRAN tfall TRIG V(QLD1,QLS1) VAL={0.9*VBUS} FALL=1 TD={T2} TARG V(QLD1,QLS1) VAL={0.1*VBUS} FALL=1 TD={T2}
TEXT 2240 1568 Left 2 !.meas TRAN trise TRIG V(QLD1,QLS1) VAL={0.1*VBUS} RISE=1 TD={T1} TARG V(QLD1,QLS1) VAL={0.9*VBUS} RISE=1 TD={T1}
