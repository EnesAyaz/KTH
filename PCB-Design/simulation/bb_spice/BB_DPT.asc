TEXT 48 -96 Left 4 ;Building block double-pulse test, 141 A (rated peak), Rg_on/Rg_off = 2/0 ohm
TEXT 48 -40 Left 2 ;2 x EPC2361 per switch, LT8418-like driver in the middle, Q3D copper: BB_PL (power loop) and BB_GL (gate star). Probe V(QL_D_L,QL_S_L), I(VILL), I(VILR), V(gtLL,QL_S_L), V(gtHL,QH_S_L).
TEXT 48 56 Left 3 ;copper (Q3D)
TEXT 48 792 Left 3 ;capacitors
TEXT 48 1112 Left 3 ;DC bus (lab supply + bulk + 20 nH busbar) and load
TEXT 48 1432 Left 3 ;FETs (0 V sources measure drain currents)
TEXT 48 1752 Left 3 ;low-side driver (pulsed) -> gate star (Q3D) -> per-FET Rg_on / Rg_off
TEXT 48 2296 Left 3 ;high-side driver (held off through the pull-down)
TEXT 2800 64 Left 2 ;--- top-level parameters (edit here) ---
TEXT 2800 104 Left 2 !.param VBUS=75 IPK=141 LLOAD=5u TON1={LLOAD*IPK/VBUS} RGON=2 RGOFF=0 RPU=0.6 RPD=0.2
TEXT 2800 144 Left 2 ;--- circuit directives (from BB_circuit.inc) ---
TEXT 2800 184 Left 2 !.include ../bb_q3d/results/BB_PL.lib
TEXT 2800 224 Left 2 !.include ../bb_q3d/results/BB_GL.lib
TEXT 2800 264 Left 2 !.include ../LMG1210-EPC2361/EPC2361.lib
TEXT 2800 304 Left 2 !.model DID D(Ron=1m Roff=1G Vfwd=0)
TEXT 2800 344 Left 2 !.param TSTART=0.5u TOFF=1u TON2=0.5u
TEXT 2800 384 Left 2 !.param T1={TSTART+TON1} T2={T1+TOFF} TEND={T2+TON2+0.3u}
TEXT 2800 424 Left 2 !.param VDRV=5
TEXT 2800 464 Left 2 !.param CLOC=2.7u RLOC=1m LLOC=0.08n CROW=24u RROW=0.375m LROW=0.0625n
TEXT 2800 504 Left 2 !.options plotwinsize=0
TEXT 2800 544 Left 2 !.tran 0 {TEND} 0 0.1n
TEXT 2800 584 Left 2 !.save V(QL_D_L) V(QL_S_L) V(QL_D_R) V(QL_S_R) V(QH_D_L) V(QH_S_L) V(QH_D_R) V(QH_S_R) V(gtLL) V(gtLR) V(gtHL) V(gtHR) V(T_AC) V(T_DCP) V(T_DCN) I(VILL) I(VILR) I(VIHL) I(VIHR) I(Lload)
TEXT 2800 656 Left 2 !.meas TRAN Iload FIND I(Lload) AT {T1}
TEXT 2800 696 Left 2 !.meas TRAN IL_L FIND I(VILL) AT {T1}
TEXT 2800 736 Left 2 !.meas TRAN IL_R FIND I(VILR) AT {T1}
TEXT 2800 776 Left 2 !.meas TRAN Eoff INTEG V(QL_D_L,QL_S_L)*I(VILL)+V(QL_D_R,QL_S_R)*I(VILR) FROM {T1} TO {T1+150n}
TEXT 2800 816 Left 2 !.meas TRAN Eon INTEG V(QL_D_L,QL_S_L)*I(VILL)+V(QL_D_R,QL_S_R)*I(VILR) FROM {T2} TO {T2+150n}
TEXT 2800 856 Left 2 !.meas TRAN VDSL_pk MAX V(QL_D_L,QL_S_L) FROM {T1} TO {T1+150n}
TEXT 2800 896 Left 2 !.meas TRAN VDSH_pk MAX V(QH_D_L,QH_S_L) FROM {T2} TO {T2+150n}
TEXT 2800 936 Left 2 !.meas TRAN VGSH_bump MAX V(gtHL,QH_S_L) FROM {T2} TO {T2+150n}
TEXT 2800 976 Left 2 !.meas TRAN VGSL_min MIN V(gtLL,QL_S_L) FROM {T1} TO {T1+150n}
TEXT 2800 1016 Left 2 !.meas TRAN VGSH_min MIN V(gtHL,QH_S_L) FROM {T1} TO {T2+150n}
TEXT 2800 1056 Left 2 !.meas TRAN ID_pk MAX I(VILL) FROM {T2} TO {T2+150n}
TEXT 2800 1096 Left 2 !.meas TRAN t_on TRIG V(QL_D_L,QL_S_L) VAL={0.8*VBUS} FALL=1 TD={T2} TARG V(QL_D_L,QL_S_L) VAL={0.2*VBUS} FALL=1 TD={T2}
TEXT 2800 1136 Left 2 !.meas TRAN t_off TRIG V(QL_D_L,QL_S_L) VAL={0.2*VBUS} RISE=1 TD={T1} TARG V(QL_D_L,QL_S_L) VAL={0.8*VBUS} RISE=1 TD={T1}
TEXT 2800 1176 Left 2 !.meas TRAN dvdt_on PARAM 0.6*VBUS/t_on/1e9
TEXT 2800 1216 Left 2 !.meas TRAN dvdt_off PARAM 0.6*VBUS/t_off/1e9
TEXT 2800 1256 Left 2 !.meas TRAN share_on PARAM ID_pk
TEXT 2800 1296 Left 2 ;gated energies (400 ns window, only while V_DS > 1 V: excludes the conduction tail; use for slow switching)
TEXT 2800 1336 Left 2 !.meas TRAN Eoff400 INTEG (V(QL_D_L,QL_S_L)*I(VILL)+V(QL_D_R,QL_S_R)*I(VILR))*(V(QL_D_L,QL_S_L)>1) FROM {T1} TO {T1+400n}
TEXT 2800 1376 Left 2 !.meas TRAN Eon400 INTEG (V(QL_D_L,QL_S_L)*I(VILL)+V(QL_D_R,QL_S_R)*I(VILR))*(V(QL_D_L,QL_S_L)>1) FROM {T2} TO {T2+400n}
