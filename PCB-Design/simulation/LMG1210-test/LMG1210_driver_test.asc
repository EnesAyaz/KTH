TEXT 64 32 Left 3 ;LMG1210 independent-input driver test - NO POWER FETS
TEXT 680 560 Left 2 ;IIM: DHL and DLH tied to VDD inside wrapper.\nHB uses an ideal floating 5 V supply for this first test.\nBST is unloaded; bootstrap operation is NOT tested here.
TEXT 64 760 Left 2 !.include LMG1210_IIM.lib
TEXT 64 792 Left 2 !.param VHS_TEST=0
TEXT 64 824 Left 2 !.tran 0 65u 0 2n
TEXT 64 856 Left 2 !.options plotwinsize=0 method=gear
TEXT 64 888 Left 2 !.meas tran VDD_FINAL FIND V(VDD) AT=60u
