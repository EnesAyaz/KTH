{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/reports/generated",
  "latex-workshop.latex.jobname": "loss_report",
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.tools": [
    {
      "name": "python-report",
      "command": "%WORKSPACE_FOLDER%/.venv/Scripts/python.exe",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/create_report.py"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "Python calculation and PDF report",
      "tools": [
        "python-report"
      ]
    }
  ],
  "files.exclude": {
    "archive": true,
    "**/__pycache__": true,
    "**/*.aux": true,
    "**/*.log": true
  },
  "search.exclude": {
    "archive/**": true,
    ".venv/**": true,
    "**/*.raw": true
  }
}