{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Analysis: draft consistency",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "analysis/check_design.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Analysis: spatial harmonics",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "analysis/harmonics.py",
        "${input:csvPath}"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "csvPath",
      "type": "promptString",
      "description": "CSV path: angle_deg,value; one uniformly sampled mechanical revolution, endpoint excluded"
    }
  ]
}