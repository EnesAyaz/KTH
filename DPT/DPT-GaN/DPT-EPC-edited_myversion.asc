TEXT 440 -472 Left 3 ;EPC2361 DOUBLE PULSE TEST - LOW-SIDE DUT
TEXT 360 -672 Left 2 ;DC link / capacitor     |     External layout     |     Load and half bridge
TEXT -8 1128 Left 2 ;Named terminals connect electrically. Llayout is additional PCB/bus loop inductance.
TEXT -8 1168 Left 2 ;Upper GaN held OFF; reverse conduction carries load current between pulses.
TEXT -8 1224 Left 3 ;GATE DRIVER - two pulses, separate pull-up / pull-down resistances
TEXT -32 1800 Left 2 ;Probe V(drain,sl), V(gl,sl), I(Vsense), I(Lload), V(bus). Energy integrals use adjustable time windows.
TEXT 1776 -416 Left 2 !.param Vin=75 Itest=50 Lload=2e-05 Rload=0.02 Tj=100 AutoT1=1 Tcharge=6.667e-06 Fsw=100000 Vlimit=100
TEXT 1792 -240 Left 2 !.param Tdelay=1e-06 Toff=1e-06 Tsecond=1e-06 Tr=2e-09 Tf=2e-09 Ttail=2e-06 Maxstep=1e-09 Wpre=2e-08 Wpost=1e-07
TEXT 1776 -24 Left 2 !.param Cin=0.0001 ESR=0.005 ESL=1e-09 Lloop=3e-09 Rloop=0.005 Rcharge=10 CSI=1e-10
TEXT 1792 152 Left 2 !.param Von=5 Voff=-5 Rg_on=1.8 Rg_off=0.5 RGD_PU=0.7 RGD_PD=0.4 Rg_HS=0.9
TEXT 1792 192 Left 2 !.param T1=if(AutoT1,Itest*Lload/Vin,Tcharge)
TEXT 1792 232 Left 2 !.param A=Tdelay+Tr+T1 B=A+Tf+Toff C=B+Tr+Tsecond Stop=C+Tf+Ttail
TEXT 1792 272 Left 2 !.model DRV_ON SW(Ron=1m Roff=1G Vt=2.5 Vh=0)
TEXT 1792 312 Left 2 !.model DRV_OFF SW(Ron=1G Roff=1m Vt=2.5 Vh=0)
TEXT 1792 352 Left 2 !.include ".\\EPCGaNLibrary.lib"
TEXT 1792 392 Left 2 !.temp {Tj}
TEXT 1792 432 Left 2 !.tran 0 {Stop} 0 {Maxstep}
TEXT 1792 472 Left 2 !.options plotwinsize=0
