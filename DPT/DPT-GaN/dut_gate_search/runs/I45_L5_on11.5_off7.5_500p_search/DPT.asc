SYMATTR InstName Lsh
SYMATTR Value {max(CSI,1e-15)}
SYMATTR SpiceLine Rser=0
FLAG 1280 336 sh
FLAG 1280 416 sw
SYMBOL voltage 1552 96 R0
SYMATTR InstName Vsense
SYMATTR Value 0
FLAG 1552 112 sw
FLAG 1552 192 drain
SYMBOL EPCGaN 1472 416 R0
SYMATTR InstName XDUT
SYMATTR Value EPC2361
SYMATTR ModelFile .\EPCGaNLibrary.lib
FLAG 1472 416 gl
FLAG 1552 320 drain
FLAG 1552 448 sl
SYMBOL ind 1536 544 R0
SYMATTR InstName Lsl
SYMATTR Value {max(CSI,1e-15)}
SYMATTR SpiceLine Rser=0
FLAG 1552 560 sl
FLAG 1552 640 0
SYMBOL voltage 928 320 R0
SYMATTR InstName Vhs
SYMATTR Value {Voff}
FLAG 928 336 offhs
FLAG 928 416 sw
SYMBOL res 928 544 R0
SYMATTR InstName Rhs
SYMATTR Value {Rg_HS}
FLAG 944 560 offhs
FLAG 944 640 gh
SYMBOL voltage 96 896 R0
WINDOW 3 24 108 Left 0
SYMATTR InstName Vcmd
SYMATTR Value PWL(0 0 {Tdelay} 0 {Tdelay+Tr} 5 {A} 5 {A+Tf} 0 {B} 0 {B+Tr} 5 {C} 5 {C+Tf} 0 {Stop} 0)
FLAG 96 912 cmd
FLAG 96 992 0
SYMBOL voltage 352 896 R0
SYMATTR InstName Von
