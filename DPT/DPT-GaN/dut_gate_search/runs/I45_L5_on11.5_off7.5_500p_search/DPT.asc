TEXT 1792 32 Left 2 !.param Vin=75 Itest=45 Lload=2e-05 Rload=0.02 Tj=100 AutoT1=0 Tcharge=1.21579678934e-05 Fsw=500000 Vlimit=100
TEXT 1792 72 Left 2 !.param Tdelay=1e-06 Toff=1e-06 Tsecond=1e-06 Tr=2e-09 Tf=2e-09 Ttail=2e-06 Maxstep=5e-10 Wpre=2e-08 Wpost=1e-07
TEXT 1792 112 Left 2 !.param Cin=0.00047 ESR=0.005 ESL=2e-10 Lloop=5e-09 Rloop=0.005 Rcharge=10 CSI=1e-10
TEXT 1792 152 Left 2 !.param Von=5 Voff=-4 Rg_on=11.5 Rg_off=7.5 RGD_PU=0.7 RGD_PD=0.4 Rg_HS=0.9
TEXT 1792 192 Left 2 !.param T1=if(AutoT1,Itest*Lload/Vin,Tcharge)
TEXT 1792 232 Left 2 !.param A=Tdelay+Tr+T1 B=A+Tf+Toff C=B+Tr+Tsecond Stop=C+Tf+Ttail
TEXT 1792 272 Left 2 !.model DRV_ON SW(Ron=1m Roff=1G Vt=2.5 Vh=0)
TEXT 1792 312 Left 2 !.model DRV_OFF SW(Ron=1G Roff=1m Vt=2.5 Vh=0)
TEXT 1792 352 Left 2 !.include ".\EPCGaNLibrary.lib"
TEXT 1792 392 Left 2 !.temp {Tj}
TEXT 1792 432 Left 2 !.tran 0 {Stop} 0 {Maxstep}
TEXT 1792 472 Left 2 !.options plotwinsize=0 method=gear reltol=1e-4 abstol=1e-9 vntol=1e-6 numdgt=7
TEXT 1792 512 Left 2 !.save V(cmd) V(gl,sl) V(gh,sh) V(drain,sl) V(bus) V(rail) V(sw) I(Lload) I(Vsense) I(Cin)
TEXT 1792 552 Left 2 !.meas tran I_first_off FIND I(Lload) AT={A}
TEXT 1792 592 Left 2 !.meas tran I_second_on FIND I(Lload) AT={B}
TEXT 1792 632 Left 2 !.meas tran Vds_peak MAX V(drain,sl)
TEXT 1792 672 Left 2 !.meas tran Vds_HS_peak MAX V(rail,sh)
TEXT 1792 712 Left 2 !.meas tran Vds_HS_min MIN V(rail,sh)
TEXT 1792 752 Left 2 !.meas tran Vgs_HS_peak MAX V(gh,sh)
TEXT 1792 792 Left 2 !.meas tran Vgs_HS_min MIN V(gh,sh)
TEXT 1792 832 Left 2 !.meas tran Vbus_min MIN V(bus)
TEXT 1792 872 Left 2 !.meas tran Eoff1_window INTEG V(drain,sl)*I(Vsense) FROM={A-Wpre} TO={A+Wpost}
TEXT 1792 912 Left 2 !.meas tran Eon2_window INTEG V(drain,sl)*I(Vsense) FROM={B-Wpre} TO={B+Wpost}
TEXT 1792 952 Left 2 !.meas tran Eoff2_window INTEG V(drain,sl)*I(Vsense) FROM={C-Wpre} TO={C+Wpost}
TEXT 1792 992 Left 2 !.meas tran Eoff1_uJ PARAM Eoff1_window*1e6
TEXT 1792 1032 Left 2 !.meas tran Eon2_uJ PARAM Eon2_window*1e6
TEXT 1792 1072 Left 2 !.meas tran Eoff2_uJ PARAM Eoff2_window*1e6
TEXT 1792 1112 Left 2 !.meas tran Psw_DUT_W PARAM (Eon2_window+Eoff1_window)*Fsw
TEXT 1792 1152 Left 2 !.meas tran Psw_second_pair_W PARAM (Eon2_window+Eoff2_window)*Fsw
