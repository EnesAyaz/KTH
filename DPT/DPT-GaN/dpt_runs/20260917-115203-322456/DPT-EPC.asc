TEXT 2440 32 Left 2 !.param Vin=75 Itest=50 Lload=2e-05 Rload=0.02 Tj=100 AutoT1=0 Tcharge=1.3537e-05 Fsw=500000 Vlimit=100
TEXT 2440 72 Left 2 !.param Tdelay=1e-06 Toff=1e-06 Tsecond=1e-06 Tr=2e-09 Tf=2e-09 Ttail=2e-06 Maxstep=2.5e-10 Wpre=2e-08 Wpost=1e-07
TEXT 2440 112 Left 2 !.param Cin=0.00047 ESR=0.005 ESL=2e-10 Rcharge=10 Cdecap=0 ESRdecap=0.005 ESLdecap=2e-10
TEXT 2440 152 Left 2 !.param Von=5 Voff=0 Rg_on=10 Rg_off=10 RGD_PU=0.7 RGD_PD=0.4 Rg_HS=0.9
TEXT 2440 192 Left 2 !.param Refined=1 Lloop=1e-09 Rloop=0.005 CSI=1e-10 RCSI=0.0001 LplusFrac=0.4 LreturnFrac=0.4 RplusFrac=0.4 RreturnFrac=0.4
TEXT 2440 232 Left 2 !.param LgLS=5e-10 LgrLS=5e-10 RgTraceLS=0.02 RgrLS=0.02 LgHS=5e-10 LgrHS=5e-10 RgTraceHS=0.02 RgrHS=0.02
TEXT 2440 272 Left 2 !.param T1=if(AutoT1,Itest*Lload/Vin,Tcharge)
TEXT 2440 312 Left 2 !.param A=Tdelay+Tr+T1 B=A+Tf+Toff C=B+Tr+Tsecond Stop=C+Tf+Ttail
TEXT 2440 352 Left 2 !.model DRV_ON SW(Ron=1m Roff=1G Vt=2.5 Vh=0)
TEXT 2440 392 Left 2 !.model DRV_OFF SW(Ron=1G Roff=1m Vt=2.5 Vh=0)
TEXT 2440 432 Left 2 !.include ".\EPCGaNLibrary.lib"
TEXT 2440 472 Left 2 !.temp {Tj}
TEXT 2440 512 Left 2 !.tran 0 {Stop} 0 {Maxstep}
TEXT 2440 552 Left 2 !.options plotwinsize=0
TEXT 2440 592 Left 2 !.save V(cmd) V(gl,sl) V(gh,sh) V(drain,sl) V(bus) V(rail) V(sw) I(Lload) I(Vsense) I(Cin)
TEXT 2440 632 Left 2 !.meas tran I_first_off FIND I(Lload) AT={A}
TEXT 2440 672 Left 2 !.meas tran I_second_on FIND I(Lload) AT={B}
TEXT 2440 712 Left 2 !.meas tran Vds_peak MAX V(drain,sl)
TEXT 2440 752 Left 2 !.meas tran Vds_HS_peak MAX V(rail,sh)
TEXT 2440 792 Left 2 !.meas tran Vds_HS_min MIN V(rail,sh)
TEXT 2440 832 Left 2 !.meas tran Vgs_LS_peak MAX V(gl,sl)
TEXT 2440 872 Left 2 !.meas tran Vgs_LS_min MIN V(gl,sl)
TEXT 2440 912 Left 2 !.meas tran Rail_peak MAX V(rail)
TEXT 2440 952 Left 2 !.meas tran Vgs_HS_peak MAX V(gh,sh)
TEXT 2440 992 Left 2 !.meas tran Vgs_HS_min MIN V(gh,sh)
TEXT 2440 1032 Left 2 !.meas tran Vbus_min MIN V(bus)
TEXT 2440 1072 Left 2 !.meas tran Eoff1_window INTEG V(drain,sl)*I(Vsense) FROM={A-Wpre} TO={A+Wpost}
TEXT 2440 1112 Left 2 !.meas tran Eon2_window INTEG V(drain,sl)*I(Vsense) FROM={B-Wpre} TO={B+Wpost}
TEXT 2440 1152 Left 2 !.meas tran Eoff2_window INTEG V(drain,sl)*I(Vsense) FROM={C-Wpre} TO={C+Wpost}
TEXT 2440 1192 Left 2 !.meas tran Eoff1_uJ PARAM Eoff1_window*1e6
TEXT 2440 1232 Left 2 !.meas tran Eon2_uJ PARAM Eon2_window*1e6
TEXT 2440 1272 Left 2 !.meas tran Eoff2_uJ PARAM Eoff2_window*1e6
TEXT 2440 1312 Left 2 !.meas tran Psw_DUT_W PARAM (Eon2_window+Eoff1_window)*Fsw
TEXT 2440 1352 Left 2 !.meas tran Psw_second_pair_W PARAM (Eon2_window+Eoff2_window)*Fsw
TEXT 2440 1392 Left 2 !.save V(pgnd) V(hs_ref) V(lret) V(hret) I(Llayout) I(Lmid) I(Lreturn) I(LgateLS) I(LgateHS)
TEXT 2440 1432 Left 2 !.meas tran Return_peak MAX V(pgnd)
TEXT 2440 1472 Left 2 !.meas tran Return_min MIN V(pgnd)
